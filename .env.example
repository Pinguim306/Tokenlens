# RPC da Robinhood Chain mainnet (chain ID 4663).
# O endpoint público funciona para desenvolvimento; para backfill use um provider dedicado.
PONDER_RPC_URL_4663=https://rpc.mainnet.chain.robinhood.com

# Bloco inicial da indexação (0 = gênesis da mainnet, jul/2026).
PONDER_START_BLOCK=0

# Postgres (docker-compose up -d). Sem DATABASE_URL o Ponder usa PGlite embutido.
DATABASE_URL=postgresql://tokenlens:tokenlens@localhost:5432/tokenlens
